# GradMent Data Platform - Environment Configuration Example
# Copy to .env for local deployment. NEVER commit .env to version control.

# Database Source (GradMent Operational MySQL - Read Only)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=analytics_ro
MYSQL_PASSWORD=your_secure_password_here
MYSQL_DATABASE=cefetconnectbanco

# Analytical Data Warehouse (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gradment_dw

# Anonymization Salt (Secret key for SHA-256 user key hashing)
ANONYMIZATION_SALT=change_this_to_a_random_secure_salt_string

# Pipeline Environment: 'synthetic' (public repo demo) or 'real' (private execution)
PIPELINE_MODE=synthetic
